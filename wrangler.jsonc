{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "diy-walking-challenges-image-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-04",
	"workers_dev": true,
	"preview_urls": false,
	"triggers": {
		"crons": ["17 4 * * *"]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1
	},
	"ai": {
		"binding": "AI"
	},
	"secrets": {
		"required": [
			"RATE_LIMIT_HASH_PEPPER",
			"REPORT_TOKEN_SECRET"
		]
	},
	"d1_databases": [
		{
			"binding": "QUOTA_DB",
			"database_name": "diywc-image-quota",
			"migrations_dir": "migrations"
		}
	],
	"ratelimits": [
		{
			"name": "INSTALL_RATE_LIMITER",
			"namespace_id": "24001",
			"simple": {
				"limit": 2,
				"period": 60
			}
		},
		{
			"name": "IP_RATE_LIMITER",
			"namespace_id": "24002",
			"simple": {
				"limit": 8,
				"period": 60
			}
		},
		{
			"name": "REPORT_RATE_LIMITER",
			"namespace_id": "24003",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"vars": {
		"DAILY_GLOBAL_NEURON_BUDGET": "10000",
		"ENFORCE_INSTALLATION_DAILY_CAPS": "false",
		"ALLOWED_ORIGINS": "",
		"ENABLED_MODELS": "flux2-klein-4b,flux-schnell",
		"SAFETY_MODEL": "@cf/meta/llama-guard-3-8b"
	}
}
